# ── Database ─────────────────────────────────────────────────────────────
# LEAVE BOTH BLOCKS COMMENTED OUT FOR LOCAL DEVELOPMENT.
# With no DATABASE_URL and no POSTGRES_* values, the backend falls back to
# the auto-created SQLite database (backend/dmfe_dev.db) and needs no setup.
#
# Uncommenting DATABASE_URL with a server that is not running makes every
# request fail with an OperationalError, because DATABASE_URL takes priority
# over the SQLite fallback (see app/core/config.py SQLALCHEMY_DATABASE_URI).
#
# Production only — point these at a real PostgreSQL instance:
# DATABASE_URL=postgresql://user:password@localhost:5432/rapidodb

# Fallback explicit PostgreSQL configs (used only if DATABASE_URL is empty)
# POSTGRES_USER=rapidouser
# POSTGRES_PASSWORD=securepassword
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rapidodb

# ── Security ─────────────────────────────────────────────────────────────
# Generate a strong random key: `openssl rand -hex 32`
# If this is left unset the app boots with a public development fallback key,
# which means anyone can forge an admin token. Always set it for deployment.
SECRET_KEY=your_super_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend domains
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ── Google Maps API (optional) ────────────────────────────────────────────
# Real travel distance/time/route for DMFE.
# Leave empty to fall back to haversine-based estimation.
GOOGLE_MAPS_API_KEY=
