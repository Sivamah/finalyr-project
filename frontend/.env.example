# API Endpoint (URL of your deployed backend)
# Example: https://rapid-backend-x0ry.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# Google Maps API Key for rendering maps and routing
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Basemap ─────────────────────────────────────────────────────────────────
# Default is keyless OpenStreetMap with the darkening treatment in index.css.
# For a natively dark basemap (better minor-road legibility), point these at a
# keyed provider and set the treatment to `native` so the filter is bypassed:
#   VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=YOUR_KEY
#   (CARTO's raster basemaps watermark anonymous, keyless requests with
#    "API KEY REQUIRED" — the key parameter is `?key=`, not `?api_key=`)
#   VITE_MAP_TILE_SUBDOMAINS=abcd
#   VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO
#   VITE_MAP_TILE_TREATMENT=native
VITE_MAP_TILE_URL=
VITE_MAP_TILE_SUBDOMAINS=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILE_TREATMENT=
